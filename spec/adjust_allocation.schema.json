{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soma:r3:adjust-allocation-input",
  "title": "Proposed R3 typed input — not implemented",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "account_id",
    "delta",
    "expected_version"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$",
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "account_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$",
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "delta": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "not": {
        "const": 0
      }
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "$comment": "JSON Schema integer means a mathematical integer. The Python MCP adapter must also use strict native integer validation (reject bool and float, including 1.0); the schema alone does not enforce lexical/numeric representation."
}
